[Unit]
Description=x11vnc remote desktop server (mirrors the local X11 session)
After=display-manager.service
Wants=display-manager.service

[Service]
Type=simple
# The display manager owns Xauthority.  Let x11vnc resolve its live path so
# this works with both GDM/Xorg and LightDM/XFCE instead of hard-coding GDM.
# FD_XDM also lets root discover GDM's greeter cookie before auto-login ends.
ExecStart=/usr/bin/x11vnc -env FD_XDM=1 -display :0 -auth guess -rfbauth /etc/x11vnc.pass -rfbport 5900 -forever -loop -noxdamage -repeat -shared
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
