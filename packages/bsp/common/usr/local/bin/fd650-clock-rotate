#!/bin/bash
# fd650-clock-rotate — FD650 front-panel: boot progress until NTP sync, then
# rotate between clock and CPU temperature.
#
# Shared by TX68 and KM7 (see fd650ctl for the per-board backend detection
# this script relies on). Board-specific boot sequence before this script
# starts is documented per board:
#   - TX68: docs/TX68_HARDWARE.md 11.2 (U-Boot "8888", kernel probe "0001").
#   - KM7: docs/KM7_HARDWARE_SPECS.md (kernel probe "0001" once patched --
#     see docs/FD650.md for status).
# Both boards' systemd units start this the instant their fd650 device
# appears (device-triggered, not after the whole of systemd-udev-settle)
# and hand off identically from there:
#   1. Until the system clock is NTP-synced, show minutes:seconds since
#      boot as a live, moving "still alive" counter -- more informative
#      than a fixed code, and it needs no separate milestones to invent
#      meaning for.
#   2. The instant NTP syncs (== the box actually has working internet),
#      switch to rotating real time and CPU temperature. If NTP sync is
#      ever lost again, fall back to the boot-progress counter
#      automatically.
set -euo pipefail

readonly FD650CTL="/usr/local/bin/fd650ctl"
export FD650_BRIGHTNESS="${FD650_BRIGHTNESS:-1}"

readonly TIME_SECONDS="${FD650_TIME_SECONDS:-3}"
readonly TEMP_SECONDS="${FD650_TEMP_SECONDS:-2}"

ntp_synced() {
	local state
	state="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
	[[ "${state}" == "yes" ]]
}

show_boot_progress() {
	local uptime_s mm ss text
	uptime_s="$(cut -d. -f1 /proc/uptime)"
	mm=$(( (uptime_s / 60) % 100 )) # clamp to 2 digits, wraps after 99:59
	ss=$(( uptime_s % 60 ))
	printf -v text '%02d%02d' "${mm}" "${ss}"
	"${FD650CTL}" show "${text}" --dot
}

while true; do
	if ! ntp_synced; then
		show_boot_progress
		sleep 1
		continue
	fi

	end=$(( $(date +%s) + TIME_SECONDS ))
	while ntp_synced && [[ $(date +%s) -lt ${end} ]]; do
		"${FD650CTL}" time
		sleep 1
	done
	ntp_synced || continue

	end=$(( $(date +%s) + TEMP_SECONDS ))
	while ntp_synced && [[ $(date +%s) -lt ${end} ]]; do
		"${FD650CTL}" temp
		sleep 1
	done
done
