#!/bin/bash
# fd650ctl - control the front-panel FD650 4-digit display.
#
# Shared between TX68 and KM7 -- both boards carry the same physical FD650
# module, but on completely different kernel drivers:
#   - TX68: out-of-tree chardev driver, /dev/fd650_dev, 6-byte write
#     protocol (4 display chars + dot_fg byte + brightness byte).
#   - KM7: Amlogic's LED-class driver in the aggregate amlogic-led.ko
#     module, /sys/class/leds/fd650/fd650_display ("dot_on text" as
#     whitespace-separated text) plus a separate brightness attribute.
# Detected at runtime -- see detect_backend().
set -euo pipefail

readonly CHARDEV="/dev/fd650_dev"
readonly SYSFS_LED_DIR="/sys/class/leds/fd650"
readonly PROG="${0##*/}"

die() { echo "${PROG}: $*" >&2; exit 1; }

detect_backend() {
	if [[ -e "${CHARDEV}" ]]; then
		echo "chardev"
	elif [[ -e "${SYSFS_LED_DIR}/fd650_display" ]]; then
		echo "sysfs-led"
	else
		die "no fd650 device found (checked ${CHARDEV}, ${SYSFS_LED_DIR}/fd650_display)"
	fi
}

readonly BACKEND="$(detect_backend)"

need_writable() {
	local path="$1"
	[[ -w "${path}" ]] || die "${path} not writable by $(id -un). Check the udev rule and your group membership (need 'video')."
}

service_name() {
	# Capture into a variable before grepping, rather than piping directly:
	# `cmd | grep -q pattern` under `pipefail` can report a false failure
	# even when grep DOES match, because grep -q exits the moment it finds
	# a match, which can SIGPIPE the still-writing upstream command --
	# pipefail then reports THAT non-zero (signal-killed) exit status for
	# the whole pipeline instead of grep's real (successful) one.
	# Confirmed on real hardware: this exact pattern silently misidentified
	# an existing km7-fd650-clock.service as absent.
	local unit_files
	unit_files="$(systemctl list-unit-files 2>/dev/null)"
	if grep -q '^tx68-fd650-clock\.service' <<< "${unit_files}"; then
		echo tx68-fd650-clock.service
	elif grep -q '^km7-fd650-clock\.service' <<< "${unit_files}"; then
		echo km7-fd650-clock.service
	else
		return 1
	fi
}

# raw_write TEXT DOT BRIGHTNESS
# TEXT: exactly 4 chars. DOT: 0/1 (center colon). BRIGHTNESS: 1-8.
raw_write() {
	local text="$1" dot="$2" brightness="$3"
	[[ ${#text} -eq 4 ]] || die "display text must be exactly 4 characters, got '${text}' (${#text})"
	[[ "${dot}" =~ ^[01]$ ]] || die "dot must be 0 or 1"
	[[ "${brightness}" =~ ^[1-8]$ ]] || die "brightness must be 1-8"

	case "${BACKEND}" in
		chardev)
			need_writable "${CHARDEV}"
			local dot_oct brightness_oct
			dot_oct="$(printf '%03o' "${dot}")"
			brightness_oct="$(printf '%03o' "${brightness}")"
			# \NNN octal escapes must be literal characters IN the format
			# string for printf to convert them to raw bytes -- printf does
			# not re-interpret escapes inside a %s-substituted argument.
			# Building the format string via bash double-quote
			# interpolation (not %s) is what makes that true here.
			printf "%s\\${dot_oct}\\${brightness_oct}" "${text}" > "${CHARDEV}"
			;;
		sysfs-led)
			need_writable "${SYSFS_LED_DIR}/fd650_display"
			# Brightness is a separate LED-class attribute on this backend,
			# not part of the display write. The KM7 kernel patch wires this
			# attribute to the same eight native FD650 intensity levels.
			need_writable "${SYSFS_LED_DIR}/brightness"
			echo "${brightness}" > "${SYSFS_LED_DIR}/brightness"
			echo "${dot} ${text}" > "${SYSFS_LED_DIR}/fd650_display"
			;;
	esac
}

cmd_show() {
	local text="${1:-}" dot="${FD650_DOT:-0}" brightness="${FD650_BRIGHTNESS:-1}"
	[[ -n "${text}" ]] || die "usage: ${PROG} show TEXT [--dot] [--brightness N]"
	shift || true
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--dot) dot=1 ;;
			--brightness) shift; brightness="${1:-1}" ;;
			*) die "unknown option: $1" ;;
		esac
		shift || true
	done
	# left-align, pad/truncate to exactly 4 chars
	printf -v text '%-4s' "${text}"
	text="${text:0:4}"
	raw_write "${text^^}" "${dot}" "${brightness}"
}

cmd_time() {
	local now dot brightness="${FD650_BRIGHTNESS:-1}"
	now="$(date +%H%M%S)"
	if (( 10#${now:4:2} % 2 )); then dot=1; else dot=0; fi
	raw_write "${now:0:4}" "${dot}" "${brightness}"
}

cmd_temp() {
	local brightness="${FD650_BRIGHTNESS:-1}"
	local zone="" raw celsius text f
	# Thermal zone naming isn't standardized across boards -- TX68's
	# sun50i-h616 zone has "cpu" in its type, KM7's Amlogic zone is named
	# "soc_thermal" (no "cpu" substring at all). Plain bash loop instead of
	# `xargs grep -l cpu`: piping a no-match grep through xargs makes xargs
	# itself exit 123 (its own "command failed" convention, not bash's),
	# which pipefail then propagates and aborts the whole script under
	# `set -e` -- confirmed on real KM7 hardware. A for-loop with an `if`
	# is exempt from that (a failing condition inside `if`/`while` never
	# triggers errexit), and naturally falls through to the thermal_zone0
	# fallback below when nothing matches "cpu".
	for f in /sys/class/thermal/thermal_zone*/type; do
		[[ -r "${f}" ]] || continue
		if grep -qi cpu "${f}" 2>/dev/null; then
			zone="${f%/type}"
			break
		fi
	done
	[[ -n "${zone}" ]] || zone="/sys/class/thermal/thermal_zone0"
	raw="$(cat "${zone}/temp" 2>/dev/null)" || die "cannot read ${zone}/temp"
	celsius=$(( raw / 1000 ))
	# '*' renders as the degree symbol (top-left square, a+b+f+g). On TX68
	# this is already in the char table (fd650.h CHAR_DEGREE). On KM7 it
	# needs the matching kernel patch (see docs/FD650.md) -- until that
	# lands, '*' just shows blank on KM7 (unmatched chars render as
	# all-segments-off there, same fallback TX68 uses for genuinely blank
	# positions), which is a harmless-looking gap, not wrong output.
	printf -v text '%2d*C' "${celsius}"
	raw_write "${text}" 0 "${brightness}"
}

cmd_custom() {
	local text="${1:-}" brightness="${FD650_BRIGHTNESS:-1}"
	[[ -n "${text}" ]] || die "usage: ${PROG} custom TEXT"
	printf -v text '%-4s' "${text}"
	text="${text:0:4}"
	raw_write "${text^^}" 0 "${brightness}"
}

cmd_off() {
	raw_write "    " 0 1
}

cmd_brightness() {
	local level="${1:-}"
	[[ "${level}" =~ ^[1-8]$ ]] || die "usage: ${PROG} brightness 1-8"
	raw_write "8888" 0 "${level}"
}

cmd_test_brightness() {
	echo "Cycling brightness 1..8, 3s each. Watch the display. Ctrl-C to stop early."
	local level
	for level in 1 2 3 4 5 6 7 8; do
		echo "level ${level}"
		raw_write "8888" 0 "${level}"
		sleep 3
	done
	raw_write "    " 0 1
}

cmd_daemon() {
	local action="${1:-}" unit
	case "${action}" in
		start|stop|restart|status) ;;
		*) die "usage: ${PROG} daemon start|stop|restart|status" ;;
	esac
	# Checked as a separate step, not inline in the case above: `exit`
	# inside a command substitution only kills that subshell, not the
	# calling script, so die() called from within "$(service_name)" would
	# silently produce an empty string here rather than actually stopping
	# execution -- confirmed on real hardware (systemctl then ran with an
	# empty unit name, "Failed to mangle name: Invalid argument").
	unit="$(service_name)" || die "no fd650 rotation service unit found"
	systemctl "${action}" "${unit}"
}

usage() {
	cat <<-EOF
	Usage: ${PROG} <command> [args]

	  show TEXT [--dot] [--brightness N]   Show arbitrary 4-char text
	  time                                 Show current HH:MM (blinking colon)
	  temp                                 Show CPU temperature
	  custom TEXT                          Alias for 'show'
	  off                                  Blank the display
	  brightness N                         Show "8888" at brightness N (1-8), for testing
	  test-brightness                      Cycle through all 8 levels, 3s each
	  daemon start|stop|restart|status     Control the fd650 rotation service

	Detected backend: ${BACKEND:-unknown}
	Env vars: FD650_BRIGHTNESS (default 1), FD650_DOT (0/1, for 'show')
	EOF
}

main() {
	local cmd="${1:-}"
	[[ -n "${cmd}" ]] || { usage; exit 1; }
	shift || true
	case "${cmd}" in
		show) cmd_show "$@" ;;
		time) cmd_time ;;
		temp) cmd_temp ;;
		custom) cmd_custom "$@" ;;
		off) cmd_off ;;
		brightness) cmd_brightness "$@" ;;
		test-brightness) cmd_test_brightness ;;
		daemon) cmd_daemon "$@" ;;
		-h|--help|help) usage ;;
		*) die "unknown command: ${cmd} (try '${PROG} help')" ;;
	esac
}

main "$@"
