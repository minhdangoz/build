// Let the desktop user (video group -- same trust level as /dev/fd650_dev
// itself, see 99-fd650.rules) start/stop/restart just the FD650 clock
// service without a sudo password. Scoped to this exact unit only --
// org.freedesktop.systemd1.manage-units is otherwise a blanket "control any
// system service" grant, which is not something the video group should get.
polkit.addRule(function(action, subject) {
	if (action.id == "org.freedesktop.systemd1.manage-units" &&
	    action.lookup("unit") == "tx68-fd650-clock.service" &&
	    subject.isInGroup("video")) {
		return polkit.Result.YES;
	}
});
