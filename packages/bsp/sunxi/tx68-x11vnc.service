[Unit]
Description=x11vnc remote desktop server for TX68 GNOME/X11 session
After=gdm.service
Wants=gdm.service

[Service]
Type=simple
ExecStart=/usr/bin/x11vnc -display :0 -auth /run/user/1000/gdm/Xauthority -rfbauth /etc/x11vnc.pass -rfbport 5900 -forever -loop -noxdamage -repeat -shared
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
