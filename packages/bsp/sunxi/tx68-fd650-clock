#!/bin/bash
# tx68-fd650-clock — default FD650 front-panel behavior: rotate between the
# current time and CPU temperature. Uses fd650ctl for all writes (single
# place that knows the /dev/fd650_dev byte protocol -- see fd650ctl's
# raw_write comment for why this can't be reimplemented with a naive printf).
set -euo pipefail

readonly FD650CTL="/usr/local/bin/fd650ctl"
export FD650_BRIGHTNESS="${TX68_FD650_BRIGHTNESS:-1}"

readonly TIME_SECONDS="${TX68_FD650_TIME_SECONDS:-3}"
readonly TEMP_SECONDS="${TX68_FD650_TEMP_SECONDS:-2}"

while true; do
	end=$(( $(date +%s) + TIME_SECONDS ))
	while [[ $(date +%s) -lt ${end} ]]; do
		"${FD650CTL}" time
		sleep 1
	done
	end=$(( $(date +%s) + TEMP_SECONDS ))
	while [[ $(date +%s) -lt ${end} ]]; do
		"${FD650CTL}" temp
		sleep 1
	done
done
