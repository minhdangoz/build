#!/bin/bash
# fd650ctl - control the TX68 front-panel FD650 4-digit display.
#
# Talks directly to /dev/fd650_dev (6-byte protocol the kernel driver
# expects: 4 display chars + dot_fg byte + brightness byte). No sudo
# needed as long as the user is in the "video" group (see
# /etc/udev/rules.d/99-fd650.rules).
set -euo pipefail

readonly DEV="/dev/fd650_dev"
readonly PROG="${0##*/}"

die() { echo "${PROG}: $*" >&2; exit 1; }

need_dev() {
	[[ -e "${DEV}" ]] || die "${DEV} not found -- is the fd650 module loaded and probed?"
	[[ -w "${DEV}" ]] || die "${DEV} not writable by $(id -un). Check /etc/udev/rules.d/99-fd650.rules and your group membership (need 'video')."
}

# write TEXT DOT BRIGHTNESS
# TEXT: exactly 4 chars, from the driver's charset (0-9, most letters, space, ':', '-', '_', '.')
# DOT: 0 or 1 (center colon)
# BRIGHTNESS: 1-8
raw_write() {
	local text="$1" dot="$2" brightness="$3"
	[[ ${#text} -eq 4 ]] || die "display text must be exactly 4 characters, got '${text}' (${#text})"
	[[ "${dot}" =~ ^[01]$ ]] || die "dot must be 0 or 1"
	[[ "${brightness}" =~ ^[1-8]$ ]] || die "brightness must be 1-8"
	local dot_oct brightness_oct
	dot_oct="$(printf '%03o' "${dot}")"
	brightness_oct="$(printf '%03o' "${brightness}")"
	# The \NNN octal escapes must be literal characters IN the format
	# string for printf to convert them to raw bytes -- printf does not
	# re-interpret escapes inside a %s-substituted argument. Building the
	# format string via bash double-quote interpolation (not %s) is what
	# makes that true here.
	printf "%s\\${dot_oct}\\${brightness_oct}" "${text}" > "${DEV}"
}

cmd_show() {
	local text="${1:-}" dot="${FD650_DOT:-0}" brightness="${FD650_BRIGHTNESS:-1}"
	[[ -n "${text}" ]] || die "usage: ${PROG} show TEXT [--dot] [--brightness N]"
	shift || true
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--dot) dot=1 ;;
			--brightness) shift; brightness="${1:-1}" ;;
			*) die "unknown option: $1" ;;
		esac
		shift || true
	done
	# left-align, pad/truncate to exactly 4 chars
	printf -v text '%-4s' "${text}"
	text="${text:0:4}"
	raw_write "${text^^}" "${dot}" "${brightness}"
}

cmd_time() {
	local now dot brightness="${FD650_BRIGHTNESS:-1}"
	now="$(date +%H%M%S)"
	if (( 10#${now:4:2} % 2 )); then dot=1; else dot=0; fi
	raw_write "${now:0:4}" "${dot}" "${brightness}"
}

cmd_temp() {
	local brightness="${FD650_BRIGHTNESS:-1}"
	local zone raw celsius text
	zone="$(grep -l '' /sys/class/thermal/thermal_zone*/type 2>/dev/null | xargs grep -l cpu 2>/dev/null | head -1)"
	zone="${zone%/type}"
	[[ -n "${zone}" ]] || zone="/sys/class/thermal/thermal_zone0"
	raw="$(cat "${zone}/temp" 2>/dev/null)" || die "cannot read ${zone}/temp"
	celsius=$(( raw / 1000 ))
	# '*' renders as the degree symbol (top-left square, a+b+f+g) --
	# see CHAR_DEGREE in fd650.h. Two-digit temps only (0-99); anything
	# outside that range would break the fixed 4-char width, but this box
	# never runs anywhere near 100C.
	printf -v text '%2d*C' "${celsius}"
	raw_write "${text}" 0 "${brightness}"
}

cmd_custom() {
	local text="${1:-}" brightness="${FD650_BRIGHTNESS:-1}"
	[[ -n "${text}" ]] || die "usage: ${PROG} custom TEXT"
	printf -v text '%-4s' "${text}"
	text="${text:0:4}"
	raw_write "${text^^}" 0 "${brightness}"
}

cmd_off() {
	raw_write "    " 0 1
}

cmd_brightness() {
	local level="${1:-}"
	[[ "${level}" =~ ^[1-8]$ ]] || die "usage: ${PROG} brightness 1-8"
	raw_write "8888" 0 "${level}"
}

cmd_test_brightness() {
	echo "Cycling brightness 1..8, 3s each. Watch the display. Ctrl-C to stop early."
	local level
	for level in 1 2 3 4 5 6 7 8; do
		echo "level ${level}"
		raw_write "8888" 0 "${level}"
		sleep 3
	done
	raw_write "    " 0 1
}

cmd_daemon() {
	local action="${1:-}"
	case "${action}" in
		start|stop|restart|status) systemctl "${action}" tx68-fd650-clock.service ;;
		*) die "usage: ${PROG} daemon start|stop|restart|status" ;;
	esac
}

usage() {
	cat <<-EOF
	Usage: ${PROG} <command> [args]

	  show TEXT [--dot] [--brightness N]   Show arbitrary 4-char text
	  time                                 Show current HH:MM (blinking colon)
	  temp                                 Show CPU temperature
	  custom TEXT                          Alias for 'show'
	  off                                  Blank the display
	  brightness N                         Show "8888" at brightness N (1-8), for testing
	  test-brightness                      Cycle through all 8 levels, 3s each
	  daemon start|stop|restart|status     Control the tx68-fd650-clock rotation service

	Env vars: FD650_BRIGHTNESS (default 1), FD650_DOT (0/1, for 'show')
	EOF
}

main() {
	need_dev
	local cmd="${1:-}"
	[[ -n "${cmd}" ]] || { usage; exit 1; }
	shift || true
	case "${cmd}" in
		show) cmd_show "$@" ;;
		time) cmd_time ;;
		temp) cmd_temp ;;
		custom) cmd_custom "$@" ;;
		off) cmd_off ;;
		brightness) cmd_brightness "$@" ;;
		test-brightness) cmd_test_brightness ;;
		daemon) cmd_daemon "$@" ;;
		-h|--help|help) usage ;;
		*) die "unknown command: ${cmd} (try '${PROG} help')" ;;
	esac
}

main "$@"
