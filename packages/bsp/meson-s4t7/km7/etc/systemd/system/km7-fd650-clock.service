[Unit]
Description=KM7 FD650 front-panel status (boot progress -> clock/temp)
# Start the instant the LED-class device exists -- not after the whole of
# systemd-udev-settle. Mirrors TX68's tx68-fd650-clock.service, same reasoning.
After=sys-devices-platform-fd650-leds-fd650.device
BindsTo=sys-devices-platform-fd650-leds-fd650.device

[Service]
Type=simple
Environment=FD650_BRIGHTNESS=1
ExecStart=/usr/local/bin/fd650-clock-rotate
Restart=on-failure
RestartSec=2

[Install]
# WantedBy a .device unit (not multi-user.target) is what makes this
# device-triggered: systemd starts it the moment the fd650 LED device
# appears, instead of waiting for multi-user.target.
WantedBy=sys-devices-platform-fd650-leds-fd650.device
