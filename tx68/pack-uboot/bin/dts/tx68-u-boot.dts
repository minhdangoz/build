		lcd-controller@6511000 {
			compatible = "allwinner,sun50i-h616-tcon-lcd\0allwinner,sun8i-r40-tcon-lcd";
			reg = <0x6511000 0x1000>;
			interrupts = <0x00 0x40 0x04>;
			clocks = <0x02 0x83 0x02 0x82>;
			clock-names = "ahb\0tcon-ch0";
			clock-output-names = "tcon-data-clock";
			#clock-cells = <0x00>;
			resets = <0x02 0x3d 0x02 0x3f>;
			reset-names = "lcd\0lvds";
			status = "disabled";
			phandle = <0xa6>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;
					phandle = <0xa7>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x39>;
						phandle = <0x32>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x3a>;
						phandle = <0x35>;
					};
				};

				port@1 {
					reg = <0x01>;
					phandle = <0xa8>;
				};
			};
		};

		lcd-controller@6515000 {
			compatible = "allwinner,sun50i-h616-tcon-tv";
			reg = <0x6515000 0x1000>;
			interrupts = <0x00 0x42 0x04>;
			clocks = <0x02 0x79 0x3b 0x00>;
			clock-names = "ahb\0tcon-ch1";
			resets = <0x02 0x36>;
			reset-names = "lcd";
			phandle = <0xa9>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;
					phandle = <0xaa>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x3c>;
						phandle = <0x33>;
					};

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x3d>;
						phandle = <0x36>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;
					phandle = <0xab>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x3e>;
						phandle = <0x37>;
					};
				};
			};
		};

		rtc@7000000 {
			compatible = "allwinner,sun50i-h616-rtc";
			reg = <0x7000000 0x400>;
			interrupts = <0x00 0x68 0x04>;
			clocks = <0x3f 0x0e 0x15 0x02 0x80>;
			clock-names = "bus\0hosc\0pll-32k";
			#clock-cells = <0x01>;
			phandle = <0x13>;
		};

		clock@7010000 {
			compatible = "allwinner,sun50i-h616-r-ccu";
			reg = <0x7010000 0x210>;
			clocks = <0x15 0x13 0x00 0x13 0x02 0x02 0x04>;
			clock-names = "hosc\0losc\0iosc\0pll-periph";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x3f>;
		};

		power-controller@7010250 {
			compatible = "allwinner,sun50i-h616-prcm-ppu";
			reg = <0x7010250 0x10>;
			#power-domain-cells = <0x01>;
			phandle = <0x11>;
		};

		interrupt-controller@7010320 {
			compatible = "allwinner,sun50i-h616-nmi\0allwinner,sun9i-a80-nmi";
			reg = <0x7010320 0x0c>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupts = <0x00 0x67 0x04>;
			phandle = <0xac>;
		};

		pinctrl@7022000 {
			compatible = "allwinner,sun50i-h616-r-pinctrl";
			reg = <0x7022000 0x400>;
			clocks = <0x3f 0x02 0x15 0x13 0x00>;
			clock-names = "apb\0hosc\0losc";
			gpio-controller;
			#gpio-cells = <0x03>;
			phandle = <0xad>;

			r-i2c-pins {
				pins = "PL0\0PL1";
				function = "s_i2c";
				phandle = <0x41>;
			};

			r-rsb-pins {
				pins = "PL0\0PL1";
				function = "s_rsb";
				phandle = <0x43>;
			};
		};

		ir@7040000 {
			compatible = "allwinner,sun50i-h616-ir\0allwinner,sun6i-a31-ir";
			reg = <0x7040000 0x400>;
			interrupts = <0x00 0x6a 0x04>;
			clocks = <0x3f 0x09 0x3f 0x0b>;
			clock-names = "apb\0ir";
			resets = <0x3f 0x05>;
			pinctrl-names = "default";
			pinctrl-0 = <0x40>;
			status = "okay";
			phandle = <0xae>;
		};

		i2c@7081400 {
			compatible = "allwinner,sun50i-h616-i2c\0allwinner,sun8i-v536-i2c\0allwinner,sun6i-a31-i2c";
			reg = <0x7081400 0x400>;
			interrupts = <0x00 0x69 0x04>;
			clocks = <0x3f 0x08>;
			dmas = <0x21 0x30 0x21 0x30>;
			dma-names = "rx\0tx";
			resets = <0x3f 0x04>;
			pinctrl-names = "default";
			pinctrl-0 = <0x41>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0xaf>;

			pmic@36 {
				compatible = "x-powers,axp313a";
				reg = <0x36>;
				vin1-supply = <0x42>;
				vin2-supply = <0x42>;
				vin3-supply = <0x42>;
				phandle = <0xb0>;

				regulators {

					aldo1 {
						regulator-always-on;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-1v8";
						phandle = <0x1d>;
					};

					dldo1 {
						regulator-always-on;
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-3v3";
						phandle = <0x1c>;
					};

					dcdc1 {
						regulator-always-on;
						regulator-min-microvolt = <0xc5c10>;
						regulator-max-microvolt = <0xf1b30>;
						regulator-name = "vdd-gpu-sys";
						phandle = <0x12>;
					};

					dcdc2 {
						regulator-always-on;
						regulator-min-microvolt = <0xc5c10>;
						regulator-max-microvolt = <0x10c8e0>;
						regulator-name = "vdd-cpu";
						phandle = <0x05>;
					};

					dcdc3 {
						regulator-always-on;
						regulator-min-microvolt = <0x14c080>;
						regulator-max-microvolt = <0x14c080>;
						regulator-name = "vdd-dram";
						phandle = <0xb1>;
					};
				};
			};
		};

		rsb@7083000 {
			compatible = "allwinner,sun50i-h616-rsb\0allwinner,sun8i-a23-rsb";
			reg = <0x7083000 0x400>;
			interrupts = <0x00 0x6d 0x04>;
			clocks = <0x3f 0x0d>;
			clock-frequency = <0x2dc6c0>;
			resets = <0x3f 0x07>;
			pinctrl-names = "default";
			pinctrl-0 = <0x43>;
			status = "disabled";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0xb2>;
		};

		dump_reg@20000 {
			compatible = "allwinner,sunxi-dump-reg";
			reg = <0x00 0x3001000 0x00 0xf20>;
			status = "okay";
			phandle = <0xb3>;
