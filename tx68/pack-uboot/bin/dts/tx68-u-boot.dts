			phandle = <0x3b>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;
					phandle = <0xa0>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x31>;
						phandle = <0x0f>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;
					phandle = <0xa1>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x32>;
						phandle = <0x39>;
					};

					endpoint@2 {
						reg = <0x02>;
						remote-endpoint = <0x33>;
						phandle = <0x3c>;
					};
				};

				port@2 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x02>;
					phandle = <0xa2>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x34>;
						phandle = <0x10>;
					};
				};

				port@3 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x03>;
					phandle = <0xa3>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x35>;
						phandle = <0x3a>;
					};

					endpoint@2 {
						reg = <0x02>;
						remote-endpoint = <0x36>;
						phandle = <0x3d>;
					};
				};

				port@4 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
