			interrupts = <0x00 0x21 0x04>;
			clocks = <0x02 0x6b 0x02 0x66>;
			resets = <0x02 0x2d>;
			phys = <0x2d 0x03>;
			phy-names = "usb";
			status = "okay";
			phandle = <0x9d>;
		};

		hdmi@6000000 {
			compatible = "allwinner,sun50i-h616-dw-hdmi\0allwinner,sun50i-h6-dw-hdmi";
			#sound-dai-cells = <0x00>;
			reg = <0x6000000 0x10000>;
			reg-io-width = <0x01>;
			interrupts = <0x00 0x3f 0x04>;
			clocks = <0x02 0x75 0x02 0x73 0x02 0x72 0x02 0x74 0x02 0x7e 0x02 0x7f>;
			clock-names = "iahb\0isfr\0tmds\0cec\0hdcp\0hdcp-bus";
			resets = <0x02 0x33 0x02 0x3a>;
			reset-names = "ctrl\0hdcp";
			phys = <0x2e>;
			phy-names = "phy";
			status = "okay";
			hvcc-supply = <0x1d>;
			phandle = <0x2c>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;
					phandle = <0x9e>;

					endpoint {
						remote-endpoint = <0x2f>;
						phandle = <0x38>;
					};
				};

				port@1 {
					reg = <0x01>;
					phandle = <0x9f>;

					endpoint {
						remote-endpoint = <0x30>;
						phandle = <0x46>;
					};
				};
			};
		};

		hdmi-phy@6010000 {
			compatible = "allwinner,sun50i-h616-hdmi-phy";
			reg = <0x6010000 0x10000>;
			clocks = <0x02 0x75 0x02 0x73>;
			clock-names = "bus\0mod";
			resets = <0x02 0x34>;
			reset-names = "phy";
			#phy-cells = <0x00>;
			phandle = <0x2e>;
		};

		tcon-top@6510000 {
			compatible = "allwinner,sun50i-h616-tcon-top\0allwinner,sun50i-h6-tcon-top";
			reg = <0x6510000 0x1000>;
