--- a/board/khadas/Kconfig
+++ b/board/khadas/Kconfig
@@ -283,15 +283,26 @@ config KHADAS_VIM1S
 	help
 	  Select Khadas VIM1S config
 
+config KHADAS_KM7
+	bool "Mecool KM7"
+	select TARGET_KHADAS_KM7
+	help
+	  Select Mecool KM7 config (DDR3, not the VIM1S LPDDR4 reference design)
