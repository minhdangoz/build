// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * TX68 / m1k_go TV box, Allwinner H618
 *
 * The vendor FDT identifies an AXP1530 PMIC. Mainline models this compatible
 * register layout with the AXP313A binding.
 *
 * Carried over from orangepi-build's sun50iw9-next Linux 6.18 canary
 * (external/patch/kernel/sun50iw9-next/0200-arm64-dts-add-tx68.patch),
 * compile-verified there against stable Linux 6.18.40. TX68 boots through
 * the vendor-signed Boot0/U-Boot/secure-TOC1 chain, not mainline U-Boot —
 * this DTB is only used once Linux itself takes over.
 */

/dts-v1/;

#include "sun50i-h616.dtsi"
#include "sun50i-h616-cpu-opp.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "TX68";
	compatible = "oranth,tx68", "allwinner,sun50i-h618";

	aliases {
		ethernet0 = &emac1;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};

	reg_vcc5v: vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	/*
	 * WL_REG_ON. The vendor DT calls this wlan_regon = <&pio PG 18
	 * GPIO_ACTIVE_HIGH> and drives it high to release the chip;
	 * mmc-pwrseq-simple states the same line as its (active-low) reset,
	 * so ACTIVE_LOW here means exactly the same electrical behaviour.
	 */
	/*
	 * VBUS switch for the USB port on PHY0. The vendor DT drives it from
	 * PH8 (usb0_drvvbus, active high) and hands it to both &ehci0 and
	 * &ohci0. Without it that port enumerates nothing, because nothing ever
	 * turns its 5V on -- everything still "works" as long as you only use
	 * the other three ports, which is why this went unnoticed.
	 */
	reg_usb0_vbus: usb0-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb0-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-enable-ramp-delay = <1000>;
		gpio = <&pio 7 8 GPIO_ACTIVE_HIGH>; /* PH8 */
		enable-active-high;
		vin-supply = <&reg_vcc5v>;
	};

	/* 500ns period -> 2MHz, the AC300 EPHY's clock input. */
	ac300_pwm_clk: ac300-clk {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		pwms = <&pwm 5 500 0>;
		clock-frequency = <2000000>;
		status = "okay";
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc 1>;
		clock-names = "osc32k-out";
		reset-gpios = <&pio 6 18 GPIO_ACTIVE_LOW>; /* PG18 */
		post-power-on-delay-ms = <200>;
	};

	/*
	 * Platform device for the aic8800_btlpm DKMS module (NOT a mainline
	 * binding -- "allwinner,sunxi-btlpm" is this out-of-tree driver's own
	 * of_match_table entry, verified by reading aic8800_btlpm.c). Without
	 * this node the module's platform_driver never probes, BT_WAKE is
	 * never toggled, and the BT core stays asleep forever: hciattach
	 * brings up hci0 on /dev/ttyS1 but every HCI command times out,
	 * confirmed on real hardware (`hci0: Opcode 0x1003 failed: -110`)
	 * with this node absent.
	 */
	bt_lpm: bt-lpm {
		compatible = "allwinner,sunxi-btlpm";
		bt_wake = <&pio 6 17 GPIO_ACTIVE_HIGH>; /* PG17 */
		bt_hostwake = <&pio 6 16 GPIO_ACTIVE_HIGH>; /* PG16 */
		status = "okay";
	};

	/*
	 * Front-panel 4-digit clock display. Out-of-tree driver
	 * (drivers/vfd/fd650.c, ported from the vendor Android BSP's
	 * drivers/vfd) matches on this custom compatible via its own
	 * of_match_table -- not a mainline binding. Property names
	 * (fd650_gpio_clk/fd650_gpio_dat) are exactly what the vendor
	 * DT and the driver's of_get_named_gpio() calls use; renaming
	 * them here would silently break the probe. Verified against
	 * vendor board.dts (m1k_go): PI11 = clock, PI12 = data,
	 * bit-banged two-wire protocol, no pinctrl group needed since
	 * the driver drives both lines as plain GPIOs.
	 */
	fd650: fd650 {
		compatible = "oranth,fd650";
		fd650_gpio_clk = <&pio 8 11 GPIO_ACTIVE_HIGH>; /* PI11 */
		fd650_gpio_dat = <&pio 8 12 GPIO_ACTIVE_HIGH>; /* PI12 */
		status = "okay";
	};

};

/*
 * sun50i-h616.dtsi reserves secmon@40000000 (512 KiB), which is where *mainline*
 * ATF puts BL31. TX68 does not run mainline ATF: it boots the vendor signed
 * chain, whose BL31 + OP-TEE live at 0x48000000 for 16 MiB (see the "bl31" node
 * in the vendor FDT, and the "Next image address = 0x4a000000" handoff in the
 * BL31 banner). Without this, Linux treats that range as free RAM and allocates
 * into the running secure monitor -- which corrupts kernel memory and produces
 * wild, unrelated oopses (observed: a dentry with a NULL superblock during an
 * i2c debugfs create). Keep Linux out of it.
 */
&{/reserved-memory} {
	bl31@48000000 {
		reg = <0x0 0x48000000 0x0 0x1000000>;
		no-map;
	};
};

&codec {
	allwinner,audio-routing = "Line Out", "LINEOUT";
	status = "okay";
};

&cpu0 {
	cpu-supply = <&reg_dcdc2>;
};

/*
 * sun50i-h616-cpu-opp.dtsi's 1512 MHz OPP (opp-supported-hw = 0x2a) only
 * covers speed bins 1/3/5 -- this board reports speed0 (dmesg:
 * "sun50i_cpufreq_nvmem: Using CPU speed bin speed0"), so mainline caps it
 * at 1416 MHz. The vendor's own Android BSP DVFS table for this exact chip
 * (sun50iw9p1/H618, sun50iw9.dtsi in the Android 5.4 kernel tree) DOES
 * define speed0 (there called "a0", same "default/weakest" bin) at
 * 1512 MHz @ 1150000 uV -- that's a factory-validated number, not a guess.
 * Re-open the shared opp-1512000000 node here (board-scoped, not editing
 * the shared dtsi) to add that voltage and add speed0 to the supported-hw
 * mask: 0x2a | bit0 (speed0) = 0x2b. Requires reg_dcdc2's
 * regulator-max-microvolt raised to 1150000 above. See
 * docs/TX68_HARDWARE.md §2.
 */
&cpu_opp_table {
	opp-1512000000 {
		opp-microvolt-speed0 = <1150000>;
		opp-supported-hw = <0x2b>;
	};
};

&de {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ehci2 {
	status = "okay";
};

&ehci3 {
	status = "okay";
};

/*
 * Ethernet is the co-packaged AC300 EPHY, not a discrete PHY on the MDIO bus.
 *
 * The giveaway is in the vendor DT: it enables &pwm5 on PA12 (pwm5_pin_a) for
 * no visible consumer. That PWM *is* the AC300's 2 MHz input clock. Together
 * with CLK_EMAC_25M it is what makes the AC300 start driving the RMII 50 MHz
 * REF_CLK back into the MAC.
 *
 * Describing this as a plain external PHY (phy-handle straight at mdio1, node
 * left with the stock "allwinner,sun50i-h616-emac" compatible) compiles and
 * probes, but neither clock is ever requested, so the AC300 stays dead, no
 * REF_CLK comes back, and the DMA soft-reset bit in EMAC_BASIC_CTL1 never
 * clears:
 *     dwmac-sun8i 5030000.ethernet: EMAC reset timeout
 *     probe with driver dwmac-sun8i failed with error -110
 * That failure happens before the PHY is ever addressed, which is why it looks
 * nothing like a PHY problem.
 *
 * Layout below follows sun50i-h618-orangepi-zero2w.dts, which is the same
 * H618 + AC300 arrangement. Note this is NOT how the H616 TV boxes in this tree
 * (x96-mate, x96q) do it -- those have a real external RMII PHY, so copying
 * them is what produced the broken version above.
 */
&emac1 {
	compatible = "allwinner,sun50i-h616-internal-emac";
	allwinner,rx-delay-ps = <3100>;
	allwinner,tx-delay-ps = <700>;
	phy-handle = <&ac300_ephy>;
	phy-mode = "rmii";
	phy-supply = <&reg_dldo1>;
	pinctrl-names = "default";
	pinctrl-0 = <&rmii_pins>;
	status = "okay";

	mdio-mux {
		compatible = "allwinner,sun8i-h3-mdio-mux";
		#address-cells = <1>;
		#size-cells = <0>;
		mdio-parent-bus = <&mdio1>;

		internal_mdio: mdio@1 {
			compatible = "allwinner,sun8i-h3-mdio-internal";
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			ac300_ephy: ethernet-phy@0 {
				compatible = "ethernet-phy-id0044.1400",
					     "allwinner,sun50i-h618-ac300-ephy",
					     "ethernet-phy-ieee802.3-c22";
				reg = <0>;
				clocks = <&ccu CLK_EMAC_25M>, <&ac300_pwm_clk>;
				clock-names = "ephy", "pwm";
				nvmem-cells = <&ephy_calibration>;
				nvmem-cell-names = "calibration";
				status = "okay";
			};
		};
	};
};

/*
 * No operating-points-v2 here, deliberately -- this board previously carried
 * a 6-step OPP table (420-648 MHz @ 960 mV) ported from the Android 14
 * apollo_p1 board.dts. It turned out to be unique in the entire mainline
 * tree: every other H616/H618 board (orangepi-zero2/zero2w/zero3,
 * bananapi-m4-berry, x96-mate, kickpi-k2b, mellow-fly-c5, transpeed-8k618-t)
 * enables &gpu with only mali-supply + status, no OPP table at all, so
 * Panfrost's devfreq core never calls dev_pm_opp_set_rate() on any of them --
 * the GPU runs at gpu0's single default clock for the whole session.
 *
 * TX68 was the only board exercising that devfreq path, and it was hitting
 * live "gpu sched timeout" hangs. gpu0 (drivers/clk/sunxi-ng/ccu-sun50i-h616.c)
 * is a mux+divider clock with two parents (pll-gpu, gpu1), so a devfreq-driven
 * clk_set_rate() between the OPP steps can re-parent the GPU clock live under
 * load -- something no other shipping H616/H618 board's kernel ever does.
 * Matching the rest of the tree (fixed clock, no DVFS) rules that out as a
 * variable. See docs/TX68_HARDWARE.md §3 before reintroducing an OPP table.
 */
&gpu {
	mali-supply = <&reg_dcdc1>;
	status = "okay";
};

&hdmi {
	hvcc-supply = <&reg_aldo1>;
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

&ir {
	status = "okay";
};

/* AC300 EPHY calibration data, burned per-chip in the eFuse. */
&sid {
	ephy_calibration: ephy-calibration@2c {
		reg = <0x2c 0x2>;
	};
};

/* PA12 -> PWM5 -> AC300 clock input. Vendor DT enables the same pin. */
&pwm {
	status = "okay";
};

&pwm5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm5_pin>;
	clk_bypass_output = <0x1>;
	status = "okay";
};

/*
 * SDIO WiFi. The chip is an AIC8800DC -- confirmed from the Android BSP, which
 * ships longan/kernel/linux-5.4/drivers/net/wireless/aic8800/ plus
 * hardware/aic/{wlan,libbt}/firmware/aic8800/aic8800dc. It is NOT the UWE5622
 * that the other H616 TV-box boards in this tree enable, so do not turn on the
 * uwe5622-allwinner extension for TX68.
 *
 * Rails mirror the vendor &sdc1: vmmc from the 3.3V rail, vqmmc from the 1.8V
 * one. The vendor also puts the whole PG bank on a 1.8V supply
 * (vcc-pg-supply = <&reg_pio1_8>), which is why the bus signalling is fixed at
 * 1.8V and the vendor sets sunxi-dis-signal-vol-sw -- there is no 3.3V state to
 * switch back to. &pio below already maps vcc-pg-supply to the same 1.8V aldo1.
 */
&mmc1 {
	vmmc-supply = <&reg_dldo1>;
	vqmmc-supply = <&reg_aldo1>;
	mmc-pwrseq = <&wifi_pwrseq>;
	bus-width = <4>;
	non-removable;
	cap-sdio-irq;
	keep-power-in-suspend;
	/*
	 * SDIO only. Vendor &sdc1 sets these too. Without them the MMC core
	 * also runs the MMC and SD identification sequences against the
	 * AIC8800 before falling back to SDIO, which is pure delay on every
	 * boot and gives a non-memory card a chance to be misidentified.
	 */
	no-mmc;
	no-sd;
	status = "okay";

	wlan: wifi@1 {
		reg = <1>;
		interrupt-parent = <&pio>;
		/* Vendor: wlan_hostwake = <&pio PG 15 GPIO_ACTIVE_HIGH> */
		interrupts = <6 15 IRQ_TYPE_EDGE_RISING>; /* PG15 WL_HOST_WAKE */
		interrupt-names = "host-wake";
	};
};

/*
 * eMMC. Deliberately NOT HS200 -- read this before "optimising" it back.
 *
 * HS200 requires CMD21 tuning to place the sampling point. sunxi-mmc does not
 * implement mmc_host_ops.execute_tuning at all, so mmc_execute_tuning() quietly
 * returns success and HS200 runs untuned, leaning entirely on the controller's
 * hardware auto-calibration. That is marginal, and the margin depends on the
 * eMMC part fitted:
 *   - board with Samsung-style HAG4a2 (14.7 GiB): HS200 @100 MHz ran fine
 *   - board with CJNB4R (58.2 GiB): repeated
 *       sunxi-mmc 4022000.mmc: data error, sending stop command
 *     (the manual-CMD12 path, only reached on a real CRC/timeout on the bus),
 *     then every execve() wedged in d_alloc_parallel and khungtaskd panicked.
 *
 * Almost no other H616 board in this tree enables HS200: bigtreetech-cb1-emmc
 * and sovol-sv08 go as far as no-1-8-v, sovol also caps at 45 MHz, x96q and
 * bananapi-m4-berry leave it off. The single exception is x96-mate, which is
 * where this node was originally copied from -- the same board that also gave
 * us the wrong Ethernet PHY arrangement. Do not treat it as the reference.
 *
 * DDR52 keeps 8-bit 1.8V transfers (~100 MB/s, plenty for this box) with far
 * more timing margin, and needs no tuning. If eMMC errors ever come back,
 * suspect aldo1: it feeds both the PC bank (eMMC signalling) and the PG bank
 * (AIC8800), so the WiFi chip and the eMMC share a 1.8V rail.
 */
&mmc2 {
	vmmc-supply = <&reg_dldo1>;
	vqmmc-supply = <&reg_aldo1>;
	bus-width = <8>;
	non-removable;
	cap-mmc-hw-reset;
	mmc-ddr-1_8v;
	max-frequency = <52000000>;
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ohci2 {
	status = "okay";
};

&ohci3 {
	status = "okay";
};

&pio {
	vcc-pa-supply = <&reg_dldo1>;
	vcc-pc-supply = <&reg_aldo1>;
	vcc-pg-supply = <&reg_aldo1>;
	vcc-ph-supply = <&reg_dldo1>;
	vcc-pi-supply = <&reg_dldo1>;
};

&r_i2c {
	status = "okay";

	axp1530: pmic@36 {
		compatible = "x-powers,axp313a";
		reg = <0x36>;

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;

		regulators {
			reg_aldo1: aldo1 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-1v8";
			};

			reg_dldo1: dldo1 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-3v3";
			};

			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				regulator-max-microvolt = <990000>;
				regulator-name = "vdd-gpu-sys";
			};

			/*
			 * The ramp delay is not optional here. cpufreq raises
			 * vdd-cpu and then immediately raises the CPU clock;
			 * the wait in between comes purely from
			 * _regulator_set_voltage_time() (drivers/regulator/core.c),
			 * which uses constraints->ramp_delay, else
			 * desc->ramp_delay, else returns 0. The AXP313A DCDC2
			 * descriptor is built with AXP_DESC_RANGES(), which
			 * hardcodes _ramp_delay = 0 -- so with no DT value the
			 * core waits *zero* microseconds and the core clock goes
			 * up while the rail is still ramping.
			 *
			 * Symptom of getting this wrong: one CPU wedges solid
			 * partway into systemd startup -- no ticks, timer softirq
			 * frozen, and no response to the backtrace IPI ("Sending
			 * NMI from CPU 0 to CPUs 3:" with nothing after it),
			 * while the other cores keep running. Which core dies
			 * moves around between boots, the signature of a marginal
			 * rail rather than a logic bug.
			 *
			 * 200 uV/us matches what mainline's own H618 board file
			 * (sun50i-h618-cpu-dvfs.dtsi, included by
			 * sun50i-h618-orangepi-zero3.dts) uses for the same PMIC.
			 * The speed0 bin steps 950000 -> 1100000 uV, so this buys
			 * 750us of settling.
			 *
			 * The regulator-step-delay-us/regulator-final-delay-us
			 * properties that appear alongside it there are inert --
			 * no driver in this tree reads them. Not copied.
			 */
			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <810000>;
				/*
				 * Raised from the mainline-default 1100000 to 1150000
				 * to cover the 1512 MHz OPP enabled for this board's
				 * speed0 bin below (&cpu_opp_table override further
				 * down this file). 1150000 is not a guess -- it's the
				 * vendor's own factory DVFS table value for this exact
				 * speed bin at this exact frequency (opp@1512000000,
				 * opp-microvolt-a0 = <1150000>, sun50iw9.dtsi, Android
				 * BSP linux-5.4 tree). PMIC (AXP1530 dcdc2) allows up
				 * to 1540000, so this stays well inside its range.
				 * See docs/TX68_HARDWARE.md §2.
				 */
				regulator-max-microvolt = <1150000>;
				regulator-ramp-delay = <200>;
				regulator-name = "vdd-cpu";
			};

			/*
			 * DDR3 at 1.5V (sys_config_tx68.fex: dram_type = 3,
			 * dram_clk = 648) -- that is what Boot0 trains the DRAM
			 * at long before Linux runs, and the vendor DT keeps
			 * this rail on a deliberately wide 0.5-1.84V range so
			 * nothing ever re-programs it.
			 *
			 * A 1360000 min/max here made the regulator core drag
			 * the live DRAM rail down during probe:
			 *   vdd-dram: Bringing 1500000uV into 1360000-1360000uV
			 * after which the board died with RCU stalls on CPU 2/3
			 * and a flickering HDMI output -- DRAM running below the
			 * voltage it was trained for. Pin it to the real 1.5V.
			 */
			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <1500000>;
				regulator-name = "vdd-dram";
			};
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_ph_pins>;
	status = "okay";
};

/*
 * Bluetooth side of the AIC8800DC, on UART1 with hardware flow control
 * (vendor &btlpm: uart_index = <1>). No child "bluetooth" node here on
 * purpose: there is no mainline serdev compatible for this part, and
 * inventing one would bind the wrong line discipline. Enabling the port
 * gives userspace /dev/ttyS1, which is what hciattach uses.
 *   BT_RST       PG19, active low   (vendor bt_rst_n) -- not wired below,
 *                unused by the DKMS aic8800_btlpm driver (grep confirmed:
 *                it only requests bt_wake and bt_hostwake)
 *   BT_WAKE      PG17, active high  (vendor bt_wake)
 *   BT_HOST_WAKE PG16, active high  (vendor bt_hostwake)
 */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
	uart-has-rtscts;
	status = "okay";
};


&usbotg {
	dr_mode = "host";
	status = "okay";
};

&usbphy {
	usb0_vbus-supply = <&reg_usb0_vbus>;
	status = "okay";
};
