+// the usual 7-segment stand-in for °. Confirmed on real hardware to read as
+// the intended small circle in the upper corner of the digit.
+#define CHAR_DEGREE	(SEG_A|SEG_B|SEG_F|SEG_G)
+
+const led_bitmap BCD_decode_tab[] =
+{
+	{'.', CHAR_DOT}, /* Let's put the dot bitmap into the table */
+	{'0', CHAR_0}, {'1', CHAR_1}, {'2', CHAR_2}, {'3', CHAR_3},
+	{'4', CHAR_4}, {'5', CHAR_5}, {'6', CHAR_6}, {'7', CHAR_7},
+	{'8', CHAR_8}, {'9', CHAR_9}, {'a', CHAR_a}, {'A', CHAR_A},
+	{'b', CHAR_b}, {'B', CHAR_B}, {'c', CHAR_c}, {'C', CHAR_C},
+	{'d', CHAR_d}, {'D', CHAR_D}, {'e', CHAR_e}, {'E', CHAR_E},
+	{'f', CHAR_f}, {'F', CHAR_F}, {'g', CHAR_g}, {'G', CHAR_G},
+	{'h', CHAR_h}, {'H', CHAR_H}, {'i', CHAR_i}, {'I', CHAR_I},
+	{'j', CHAR_j}, {'J', CHAR_J}, {'l', CHAR_l}, {'L', CHAR_L},
+	{'n', CHAR_n}, {'N', CHAR_N}, {'o', CHAR_o}, {'O', CHAR_O},
+	{'p', CHAR_p}, {'P', CHAR_P}, {'q', CHAR_Q}, {'Q', CHAR_Q},
+	{'r', CHAR_r}, {'R', CHAR_R}, {'s', CHAR_s}, {'S', CHAR_S},
+	{'t', CHAR_t}, {'T', CHAR_T}, {'u', CHAR_u}, {'U', CHAR_U},
+	{'y', CHAR_y}, {'Y', CHAR_Y}, {'z', CHAR_z}, {'Z', CHAR_Z},
+	{':', CHAR_DOT}, {'-', CHAR_TAB1}, {'_', CHAR_TAB2}, {' ', CHAR_SPA},
+	{'*', CHAR_DEGREE}
+};
+#endif
+
+// **NEW: Common error code definitions for convenience**
+#define FD650_ERROR_NETWORK    "InEt"  // Internet/Network error
+#define FD650_ERROR_WIFI       "WiFi"  // WiFi connection error
+#define FD650_ERROR_SYSTEM     "SYS "  // System error
+#define FD650_ERROR_STORAGE    "dISC"  // Storage/Disk error
+#define FD650_ERROR_BATTERY    "bAtt"  // Battery error
+#define FD650_ERROR_TEMPERATURE "tEMP" // Temperature error
+#define FD650_ERROR_BOOT       "boot"  // Boot error
+#define FD650_ERROR_UPDATE     "UPdt"  // Update error
+#define FD650_ERROR_GENERIC_1  "E001"  // Generic error code 1
+#define FD650_ERROR_GENERIC_2  "E002"  // Generic error code 2
+#define FD650_ERROR_GENERIC_3  "E003"  // Generic error code 3
