+static int fd650_dev_open(struct inode *inode, struct file *file)
+{
+    fd650_dev_t *dev = NULL;
+
+    file->private_data = pdata->dev;
+	dev = file->private_data;
+
+	pr_dbg("%s:::open fd650 dev success\n", __FUNCTION__);
+    return 0;
+}
+
+static int fd650_dev_release(struct inode *inode, struct file *file)
+{
+    //fd650_dev_t *dev = file->private_data;
+	file->private_data = NULL;
+
+	pr_dbg("%s:::close fd650 dev success\n", __FUNCTION__);
+    return 0;
+}
+
+static ssize_t
+fd650_dev_read(struct file *filp, char __user *buf, size_t count, loff_t *f_pos)
+{
+	fd650_dev_t *dev = filp->private_data;
+	int size = ((count <= sizeof(dev->wbuf)) ? count : sizeof(dev->wbuf));
+
+	return copy_to_user((void __user *)buf, dev->wbuf, size);
+}
+
+static ssize_t
+fd650_dev_write(struct file *filp, const char __user *buf, size_t count, loff_t *f_pos)
+{
+	fd650_dev_t *dev;
+	uint32 missing;
+	int status = 0;
+
+	dev = filp->private_data;
+	if (count > 6)
+		count = 6;
+
+	if (kp->state == 0)
+		return status;
+
+	if (down_interruptible(&dev->sem)) {
+		return -1;
+	}
+
+	missing = copy_from_user(dev->wbuf, buf, count);
+	if (missing == 0) {
+		dev->dot_fg = dev->wbuf[4];
+		dev->brightness = dev->wbuf[5];
+		Led_Show_650(dev->wbuf, dev);
+		memset(dev->wbuf, 0, sizeof(dev->wbuf));
+		status = count;
+	}
+
+	up(&dev->sem);
+	return status;
+}
+
+static long
+fd650_dev_ioctl(struct file *filp, unsigned int cmd, unsigned long arg)
+{
+	int err = 0, ret = 0;
+    fd650_dev_t *dev;
+	dev = filp->private_data;
+
+	/* don't even decode wrong cmds: better returning  ENOTTY than EFAULT */
+	if (_IOC_TYPE(cmd) != FD650_IOC_MAGIC)
+		return -ENOTTY;
+	if (_IOC_NR(cmd) > FD650_IOC_MAXNR)
+		return -ENOTTY;
+
+	/*
+	 * the type is a bitmask, and VERIFY_WRITE catches R/W
+	 * transfers. Note that the type is user-oriented, while
+	 * verify_area is kernel-oriented, so the concept of "read" and
+	 * "write" is reversed
+	 */
+	if (_IOC_DIR(cmd) & _IOC_READ)
+		err = !access_ok((void __user *)arg, _IOC_SIZE(cmd));
+	else if (_IOC_DIR(cmd) & _IOC_WRITE)
+		err = !access_ok((void __user *)arg, _IOC_SIZE(cmd));
+	if (err)
+		return -EFAULT;
+
+	if (down_interruptible(&dev->sem)) {
+		return -1;
+	}
+
+	switch (cmd) {
+		case FD650_IOCTEST:
+			dev->dot_fg = 0x01;
+			Led_Show_650("8888", dev);
+			break;
+
+		case FD650_IOC_SDOT: /* Set: arg points to the value */
+			ret = __get_user(dev->dot_fg, (int __user *)arg);
+			break;
+
+		case FD650_IOC_GDOT: /* Get: arg is pointer to result */
+			ret = __put_user(dev->dot_fg, (int __user *)arg);
+			break;
+
+		case FD650_IOC_GVER:
+			ret = copy_to_user((unsigned char __user*)arg, FD650_DRIVER_VERSION, sizeof(FD650_DRIVER_VERSION));
+			break;
+
+		case FD650_IOC_SBRIGHT:
+			ret = __get_user(dev->brightness, (int __user *)arg);
+			break;
+
+		case FD650_IOC_GBRIGHT:
+			ret = __put_user(dev->brightness, (int __user *)arg);
+			break;
+
+		// **NEW: Enhanced error handling IOCTLs**
+		case FD650_IOC_SET_MODE:
+			ret = __get_user(dev->display_mode, (int __user *)arg);
+			break;
+
+		case FD650_IOC_GET_MODE:
+			ret = __put_user(dev->display_mode, (int __user *)arg);
+			break;
+
+		case FD650_IOC_SET_ERROR:
+			if (copy_from_user(dev->error_msg, (char __user *)arg, 4) == 0) {
+				dev->error_msg[4] = '\0';
+				dev->display_mode = FD650_MODE_ERROR;
+				dev->error_time = ktime_get_seconds();
+				Led_Show_650(dev->error_msg, dev);
+				pr_dbg("Error set to '%s'\n", dev->error_msg);
+			}
+			break;
+
+		case FD650_IOC_GET_ERROR:
+			ret = copy_to_user((char __user *)arg, dev->error_msg, 5);
+			break;
+
+		case FD650_IOC_CLEAR_ERROR:
+			dev->display_mode = FD650_MODE_TIME;
+			memset(dev->error_msg, 0, sizeof(dev->error_msg));
+			dev->error_priority = FD650_PRIORITY_NONE;
+			pr_dbg("Error cleared\n");
+			break;
+
+		case FD650_IOC_SET_CUSTOM:
+			if (copy_from_user(dev->custom_msg, (char __user *)arg, 4) == 0) {
+				dev->custom_msg[4] = '\0';
+				dev->display_mode = FD650_MODE_CUSTOM;
+				Led_Show_650(dev->custom_msg, dev);
+				pr_dbg("Custom message set to '%s'\n", dev->custom_msg);
+			}
+			break;
+
+		default:  /* redundant, as cmd was checked against MAXNR */
+			ret = -ENOTTY;
+			break;
+	}
+
+	up(&dev->sem);
+	return ret;
+}
