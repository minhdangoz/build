+static int register_fd650_driver(void)
+{
+    int ret = 0;
+
+    ret = misc_register(&fd650_device);
+	if (ret)
+		pr_error("ERROR: %s:::register fd650 driver fail !!!\n", __func__);
+	else
+		pr_dbg("NOTE: %s:::register fd650 driver success\n", __func__);
+
+	return ret;
+}
+
+static uint8 deregister_fd650_driver(void)
+{
+	misc_deregister(&fd650_device);
+
+	return 0;
+}
+
+static void
+fd628_brightness_set(struct led_classdev *cdev,	enum led_brightness brightness)
+{
+	pr_info("brightness = %d\n", brightness);
+
+	if (pdata == NULL)
+		return ;
+
+//	pdata->dev->brightness = brightness;
+//	FD628_SET_BRIGHTNESS(pdata->dev->brightness, pdata->dev, FD628_DISP_ON);
+//	pdata->dev->wbuf[8] = brightness;
+	//采用递增模式写入显示数据
+//	FD628_WrDisp_AddrINC(0x00, 2*5, pdata->dev);
+}
+
+static ssize_t
+led_light_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%s\n", pdata->dev->wbuf);
+}
+
+static ssize_t
+led_light_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t size)
+{
+	unsigned int val;
+	if (pdata == NULL)
+		return size;
+
+	if (down_interruptible(&pdata->dev->sem)) {
+		return -1;
+	}
+
+	if (!kstrtouint(buf, 16, &val) && val > 0 && val < 9) {
+	        _fd650_resume();
+
+                pdata->dev->dot_fg = 0x00;      // dot 中间冒号
+                pdata->dev->brightness = val;     // 数码管亮度
+                Led_Show_650("8888", pdata->dev);
+	}
+
+	if (strncmp(buf, "on", 2) == 0) {
+		_fd650_resume();
+
+		pdata->dev->dot_fg = 0x00;  	// dot 中间冒号
+		pdata->dev->brightness = 3;  	// 数码管亮度
+		Led_Show_650("8888", pdata->dev);
+	} else if (strncmp(buf, "off", 3) == 0) {
+		_fd650_suspend();
+	} else {
+		pr_error("unknown arguement: %s\n", buf);
+	}
+
+	up(&pdata->dev->sem);
+	return size;
+}
+
+static DEVICE_ATTR(led_light, 0664, led_light_show, led_light_store);
+
+static int fd650_driver_probe(struct platform_device *pdev)
+{
+	int ret = -EINVAL;
+
+    if (!pdev->dev.of_node) {
+		pr_error("fd650_driver: pdev->dev.of_node == NULL!\n");
+		ret = -EINVAL;
+		goto error;
+	}
+
+	pdata = kzalloc(sizeof(*pdata), GFP_KERNEL);
+    if (!pdata) {
+        pr_error("malloc platform data failed!\n");
+        ret = -ENOMEM;
+        goto error;
+    }
+
+	pdata->dev = kzalloc(sizeof(*(pdata->dev)), GFP_KERNEL);
+	if (!(pdata->dev)) {
+		pr_error("malloc platform dev failed!\n");
+		ret = -ENOMEM;
+		goto error2;
+	}
+
+	pdata->dev->clk_pin = of_get_named_gpio(pdev->dev.of_node,
+								"fd650_gpio_clk", 0);
+	if (!gpio_is_valid(pdata->dev->clk_pin)) {
+		pr_error("fd650_clk gpio is unvalid");
+		ret = -EINVAL;
+		goto error3;
+	}
+
+	ret = gpio_request(pdata->dev->clk_pin, MOD_NAME_CLK);
+	if (ret) {
+		pr_error("can't request gpio of fd650_clk");
+		goto error3;
+	}
+
+	pdata->dev->dat_pin = of_get_named_gpio(pdev->dev.of_node,
+								"fd650_gpio_dat", 0);
+	if (!gpio_is_valid(pdata->dev->dat_pin)) {
+		pr_error("fd650_dat gpio is unvalid");
+		ret = -EINVAL;
+		goto error3;
+	}
+
+	ret = gpio_request(pdata->dev->dat_pin, MOD_NAME_DAT);
+	if (ret) {
+		pr_error("can't request gpio of fd650_dat");
+		goto error3;
+	}
+
+	platform_set_drvdata(pdev, pdata);
+	register_fd650_driver();
+	sema_init(&pdata->dev->sem, 1);
+
+	kp = kzalloc(sizeof(struct kp), GFP_KERNEL);
+	if (!kp) {
+		kfree(kp);
+		ret = -ENOMEM;
+		goto error4;
+	}
+
+	kp->cdev.name = DEV_NAME;
+	kp->cdev.brightness_set = fd628_brightness_set;
+	ret = led_classdev_register(&pdev->dev, &kp->cdev);
+	if (ret < 0) {
+		goto error5;
+	}
+
+	kp->state = 1;
+	device_create_file(kp->cdev.dev, &dev_attr_led_light);
+
+	// pdata->dev->dot_fg = 0x00;  	// dot 中间冒号
+	// pdata->dev->brightness = 3;  	// 数码管亮度
+	// Led_Show_650("8888", pdata->dev);
+	pdata->dev->display_mode = FD650_MODE_TIME;
+	memset(pdata->dev->error_msg, 0, sizeof(pdata->dev->error_msg));
+	memset(pdata->dev->custom_msg, 0, sizeof(pdata->dev->custom_msg));
+	pdata->dev->error_priority = FD650_PRIORITY_NONE;
+	pdata->dev->error_time = 0;
+	pdata->dev->auto_clear_timeout = 0;
+
+	pdata->dev->dot_fg = 0x00;  	// dot 中间冒号
+	pdata->dev->brightness = 3;  	// 数码管亮度
+	Led_Show_650("8888", pdata->dev);
+
+#ifdef CONFIG_HAS_EARLYSUSPEND
+	//fd650_early_suspend.level = EARLY_SUSPEND_LEVEL_BLANK_SCREEN;
+	//fd650_early_suspend.suspend = fd650_suspend;
+	//fd650_early_suspend.resume = fd650_resume;
+	//register_early_suspend(&fd650_early_suspend);
+#endif
+
+
+	// Create sysfs attributes with proper error handling
+	ret = device_create_file(&pdev->dev, &dev_attr_error_code);
+	if (ret) {
+		pr_error("Failed to create error_code sysfs entry\n");
+		goto error_sysfs1;
+	}
+
+	ret = device_create_file(&pdev->dev, &dev_attr_display_mode);
+	if (ret) {
+		pr_error("Failed to create display_mode sysfs entry\n");
+		goto error_sysfs2;
+	}
+
+	ret = device_create_file(&pdev->dev, &dev_attr_custom_msg);
+	if (ret) {
+		pr_error("Failed to create custom_msg sysfs entry\n");
+		goto error_sysfs3;
+	}
+
+	ret = device_create_file(&pdev->dev, &dev_attr_version);
+	if (ret) {
+		pr_error("Failed to create version sysfs entry\n");
+		goto error_sysfs4;
+	}
+
+    return 0;
+
+error_sysfs4:
+    device_remove_file(&pdev->dev, &dev_attr_custom_msg);
+error_sysfs3:
+    device_remove_file(&pdev->dev, &dev_attr_display_mode);
+error_sysfs2:
+    device_remove_file(&pdev->dev, &dev_attr_error_code);
+error_sysfs1:
+    device_remove_file(kp->cdev.dev, &dev_attr_led_light);
+    led_classdev_unregister(&kp->cdev);
+    goto error5;
+error5:
+	kfree(kp);
+error4:
+	deregister_fd650_driver();
+	gpio_free(pdata->dev->clk_pin);
+   	gpio_free(pdata->dev->dat_pin);
+error3:
+	kfree(pdata->dev);
+error2:
+	kfree(pdata);
+error:
+    return ret;
+}
+
+static void fd650_driver_remove(struct platform_device *pdev)
+{
+	pdata->dev->dot_fg = 0x00;
+	Led_Show_650("****", pdata->dev);
+
+#ifdef CONFIG_HAS_EARLYSUSPEND
+	unregister_early_suspend(&fd650_early_suspend);
+#endif
+	device_remove_file(kp->cdev.dev, &dev_attr_led_light);
+
+	led_classdev_unregister(&kp->cdev);
+	kfree(kp);
+    deregister_fd650_driver();
+
+	gpio_free(pdata->dev->clk_pin);
+   	gpio_free(pdata->dev->dat_pin);
+
+	kfree(pdata->dev);
+	kfree(pdata);
+
+
+	device_remove_file(&pdev->dev, &dev_attr_version);
+	device_remove_file(&pdev->dev, &dev_attr_custom_msg);
+	device_remove_file(&pdev->dev, &dev_attr_display_mode);
+	device_remove_file(&pdev->dev, &dev_attr_error_code);
+
+	pr_dbg("Sysfs entries created successfully\n");
+}
+
+static int _fd650_suspend(void)
+{
+	if (kp->state != 0) {
+		kp->state = 0;
+		pr_dbg("%s:::close LED FD650\n", __func__);
+
+		pdata->dev->dot_fg = 0x00;
+		Led_Show_650("****", pdata->dev);
+
+		pr_dbg("%s:::gpio_free MOD_NAME_CLK and MOD_NAME_DAT\n", __FUNCTION__);
+
+		gpio_free(pdata->dev->clk_pin);
+		gpio_free(pdata->dev->dat_pin);
+	}
+
+	return 0;
+}
+
+static int _fd650_resume(void)
+{
+	int ret = -1;
+
+	if (kp->state != 1) {
+		kp->state = 1;
+		pr_dbg("%s:::gpio_request MOD_NAME_CLK and MOD_NAME_DAT\n", __FUNCTION__);
+
+		ret = gpio_request(pdata->dev->clk_pin, MOD_NAME_CLK);
+		if (ret) {
+			pr_error("---%s----can not request pin %d\n", __func__, pdata->dev->clk_pin);
+			return -1;
+		}
+
+		ret = gpio_request(pdata->dev->dat_pin, MOD_NAME_DAT);
+		if (ret) {
+			pr_error("---%s----can not request pin %d\n", __func__, pdata->dev->dat_pin);
+			return -1;
+		}
+	}
+
+    return 0;
+}
+
+#ifdef CONFIG_HAS_EARLYSUSPEND
+static void fd650_suspend(struct early_suspend *h)
+{
+	_fd650_suspend();
+
+	return ;
+}
+
+static void fd650_resume(struct early_suspend *h)
+{
+	_fd650_resume();
+
+    return ;
+}
+#endif
+
+static void fd650_driver_shutdown(struct platform_device *dev)
+{
+	_fd650_suspend();
+
+	return ;
+}
+
+#ifdef CONFIG_OF
+static const struct of_device_id fd650_dt_match[] = {
+	{ .compatible = "oranth,fd650", .data = NULL },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, fd650_dt_match);
+#else
+#define fd650_dt_match NULL
+#endif
+
+static struct platform_driver fd650_driver = {
+    .probe      = fd650_driver_probe,
+    .remove     = fd650_driver_remove,
+    .shutdown   = fd650_driver_shutdown,
+#ifdef CONFIG_PM
+    //.suspend    = fd650_driver_suspend,
+    //.resume     = fd650_driver_resume,
+#endif
+    .driver     = {
+        .name   = DEV_NAME,
+		.owner	= THIS_MODULE,
+        .of_match_table = of_match_ptr(fd650_dt_match),
+    },
+};
+
+static int __init fd650_driver_init(void)
+{
+    pr_dbg("%s: FD650 Driver init.\n", __func__);
+
+    return platform_driver_register(&fd650_driver);
+}
+
+static void __exit fd650_driver_exit(void)
+{
+    pr_dbg("%s: FD650 Driver exit.\n", __func__);
+
+    platform_driver_unregister(&fd650_driver);
+}
+
+late_initcall(fd650_driver_init);
+module_exit(fd650_driver_exit);
+
+MODULE_AUTHOR("chenmy");
+MODULE_DESCRIPTION("fd650 Driver");
+MODULE_LICENSE("GPL");
