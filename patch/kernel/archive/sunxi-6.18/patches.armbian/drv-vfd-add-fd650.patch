+
+static int gpio_data_set(unsigned int gpio, int data)
+{
+	gpio_direction_output(gpio, data);
+	//__gpio_set_value(gpio, data);
+
+	return 0;
+}
+
+static int gpio_data_get(unsigned int gpio)
+{
+	return gpio_get_value(gpio);
+}
+
+static void FD650_Mcu_Start(fd650_dev_t *dev)
+{
+	gpio_data_set(dev->dat_pin, 1);
+    gpio_data_set(dev->clk_pin, 1);
+	DELAY;
+	gpio_data_set(dev->dat_pin, 0);
+	DELAY;
+	gpio_data_set(dev->clk_pin, 0);
+}
+
+static void FD650_Mcu_Stop(fd650_dev_t *dev)
+{
+	gpio_data_set(dev->dat_pin, 0);
+	DELAY;
+	gpio_data_set(dev->clk_pin, 1);
+	DELAY;
+	gpio_data_set(dev->dat_pin, 1);
+	DELAY;
+
+	gpio_direction_input(dev->dat_pin);
+}
+
+static void FD650_Mcu_WrByte(uint8 dat, fd650_dev_t *dev)
+{
+	uint8 i;
+
+	for (i = 0; i != 8; i++) {
+		if (dat & 0x80) {
+			gpio_data_set(dev->dat_pin, 1);
+		} else {
+			gpio_data_set(dev->dat_pin, 0);
+		}
+
+		DELAY;
+		gpio_data_set(dev->clk_pin, 1);
+		dat <<= 1;
+		DELAY;  // 可选延时
+		gpio_data_set(dev->clk_pin, 0);
+	}
+
+	gpio_data_set(dev->dat_pin, 1);
+	gpio_direction_input(dev->dat_pin);
+	DELAY;
+	gpio_data_set(dev->clk_pin, 1);
+	DELAY;
+	gpio_data_set(dev->clk_pin, 0);
+}
+
+static uint8 FD650_Mcu_RdByte(fd650_dev_t *dev)
+{
+	uint8 dat, i;
+	dat = 0;
+
+	gpio_data_set(dev->dat_pin, 1);
+	gpio_direction_input(dev->dat_pin);
+
+	for (i = 0; i != 8; i++) {
+		DELAY;  // 可选延时
+		gpio_data_set(dev->clk_pin, 1);
+		DELAY;  // 可选延时
+
+		dat <<= 1;
+		if (gpio_data_get(dev->dat_pin))
+			dat++;
+
+		gpio_data_set(dev->clk_pin, 0);
+	}
+
+	gpio_data_set(dev->dat_pin, 1);
+	DELAY;
+	gpio_data_set(dev->clk_pin, 1);
+	DELAY;
+	gpio_data_set(dev->clk_pin, 0);
+
+	return dat;
+}
+
+void FD650_Mcu_Write(uint16 cmd, fd650_dev_t *dev)
+{
+	uint8 value = 0;
+
+	value = (uint8)(cmd >> 7) & 0x3E;
+	value|= 0x40;
+
+	FD650_Mcu_Start(dev);
+	FD650_Mcu_WrByte(value, dev);
+	FD650_Mcu_WrByte((uint8)cmd, dev);
+	FD650_Mcu_Stop(dev);
+}
+
+uint8 FD650_Mcu_Read(fd650_dev_t *dev)
+{
+	uint8 keycode = 0;
+	uint8 value = 0;
+
+	value = (uint8)(FD650_GET_KEY >> 7) & 0x3E;
+	value |= 0x41;
+
+	FD650_Mcu_Start(dev);
+	FD650_Mcu_WrByte(value, dev);
+	keycode=FD650_Mcu_RdByte(dev);
+	FD650_Mcu_Stop(dev);
+
+	if ((keycode & 0x00000040) == 0)
+		keycode = 0;
+
+	return keycode;
+}
