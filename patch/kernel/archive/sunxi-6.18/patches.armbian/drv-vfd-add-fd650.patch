+// Error code attribute
+static ssize_t error_code_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    if (pdata == NULL || pdata->dev == NULL)
+        return sprintf(buf, "\n");
+
+    return sprintf(buf, "%s\n", pdata->dev->error_msg);
+}
+
+static ssize_t error_code_store(struct device *dev, struct device_attribute *attr,
+                               const char *buf, size_t size)
+{
+    char input[16];
+
+    if (pdata == NULL || pdata->dev == NULL) {
+        pr_error("Device not initialized\n");
+        return -ENODEV;
+    }
+
+    // Copy input safely
+    memset(input, 0, sizeof(input));
+    if (size > 0) {
+        strncpy(input, buf, min((int)size, 15));
+        // Remove newline if present
+        if (input[strlen(input)-1] == '\n') {
+            input[strlen(input)-1] = '\0';
+        }
+    }
+
+    if (down_interruptible(&pdata->dev->sem))
+        return -ERESTARTSYS;
+
+    pr_dbg("error_code_store: received '%s'\n", input);
+
+    if (strncmp(input, "clear", 5) == 0 || strlen(input) == 0) {
+        // Clear error
+        pdata->dev->display_mode = FD650_MODE_TIME;
+        memset(pdata->dev->error_msg, 0, sizeof(pdata->dev->error_msg));
+        pdata->dev->error_priority = FD650_PRIORITY_NONE;
+        pr_dbg("Error cleared, returning to time mode\n");
+    } else {
+        // Set error and display immediately
+        memset(pdata->dev->error_msg, 0, sizeof(pdata->dev->error_msg));
+        strncpy(pdata->dev->error_msg, input, 4);
+        pdata->dev->error_msg[4] = '\0';
+        pdata->dev->display_mode = FD650_MODE_ERROR;
+        pdata->dev->error_priority = FD650_PRIORITY_NORMAL;
+        pdata->dev->error_time = ktime_get_seconds();
+
+        // Display the error immediately
+        Led_Show_650(pdata->dev->error_msg, pdata->dev);
+        pr_dbg("Error set to '%s' and displayed\n", pdata->dev->error_msg);
+    }
+
+    up(&pdata->dev->sem);
+    return size;
+}
+
+static DEVICE_ATTR(error_code, 0664, error_code_show, error_code_store);
+
+// Display mode attribute
+static ssize_t display_mode_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    if (pdata == NULL || pdata->dev == NULL)
+        return sprintf(buf, "-1\n");
+
+    return sprintf(buf, "%d\n", pdata->dev->display_mode);
+}
+
+static ssize_t display_mode_store(struct device *dev, struct device_attribute *attr,
+                                 const char *buf, size_t size)
+{
+    int mode;
+
+    if (pdata == NULL || pdata->dev == NULL)
+        return -ENODEV;
+
+    if (sscanf(buf, "%d", &mode) != 1)
+        return -EINVAL;
+
+    if (mode < 0 || mode > 2)
+        return -EINVAL;
+
+    if (down_interruptible(&pdata->dev->sem))
+        return -ERESTARTSYS;
+
+    pdata->dev->display_mode = mode;
+    pr_dbg("Display mode set to %d\n", mode);
+
+    up(&pdata->dev->sem);
+    return size;
+}
+
+static DEVICE_ATTR(display_mode, 0664, display_mode_show, display_mode_store);
+
+// Custom message attribute
+static ssize_t custom_msg_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    if (pdata == NULL || pdata->dev == NULL) {
+        return sprintf(buf, "\n");
+    }
+
+    return sprintf(buf, "%s\n", pdata->dev->custom_msg);
+}
+
+static ssize_t custom_msg_store(struct device *dev, struct device_attribute *attr,
+                               const char *buf, size_t size)
+{
+    char input[16];
+
+    if (pdata == NULL || pdata->dev == NULL) {
+        return -ENODEV;
+    }
+
+    // Copy input safely
+    memset(input, 0, sizeof(input));
+    if (size > 0) {
+        strncpy(input, buf, min((int)size, 15));
+        // Remove newline if present
+        if (input[strlen(input)-1] == '\n') {
+            input[strlen(input)-1] = '\0';
+        }
+    }
+
+    if (down_interruptible(&pdata->dev->sem)) {
+        return -ERESTARTSYS;
+    }
+
+    memset(pdata->dev->custom_msg, 0, sizeof(pdata->dev->custom_msg));
+    if (strlen(input) > 0) {
+        strncpy(pdata->dev->custom_msg, input, 4);
+        pdata->dev->custom_msg[4] = '\0';
+        pdata->dev->display_mode = FD650_MODE_CUSTOM;
+        Led_Show_650(pdata->dev->custom_msg, pdata->dev);
+        pr_dbg("Custom message set to '%s'\n", pdata->dev->custom_msg);
+    } else {
+        // Empty input clears custom message
+        pdata->dev->display_mode = FD650_MODE_TIME;
+        pr_dbg("Custom message cleared\n");
+    }
+
+    up(&pdata->dev->sem);
+    return size;
+}
+
+static DEVICE_ATTR(custom_msg, 0664, custom_msg_show, custom_msg_store);
