+static uint8 Led_Get_Code(uint8 input)
+{
+	uint8 i, bitmap = 0xFF;
+
+	for (i = 0; i < LEDMAPNUM; i++)
+	{
+		if (BCD_decode_tab[i].character == input)
+		{
+			bitmap = BCD_decode_tab[i].bitmap;
+			/*
+			pr_dbg("%s:::Input char: %c, found the right bcd_code:0x%x \n",
+				__FUNCTION__, input, bitmap);
+				*/
+			break;
+		}
+	}
+
+	return bitmap;
+}
+
+static uint8 Led_Show_650(uint8 *pinput, fd650_dev_t *dev)
+{
+	uint8 i, len, abort = 0;
+	uint8 data[4] = {0};
+	uint16 value = 0;
+
+	if (pinput == NULL)
+	{
+		pr_error("%s:::acfPStr == NULL !!!\n", __FUNCTION__);
+		return -1;
+	}
+
+	len = strlen(pinput);
+
+	if (len > 4)
+		len = 4;
+	else if (len < 4)
+		return -1;
+
+	for (i = 0; i < len; i++)
+	{
+		if (pinput[i] == 0x00)
+		{
+			abort = 1;
+			break;
+		}
+		data[i] = Led_Get_Code(pinput[i]);
+		/*
+		pr_dbg("%s:::pinput[%d] == %c, data[%d] == 0x%02X\n",
+		__FUNCTION__,  i, pinput[i], i, data[i]);
+		*/
+		if (data[i] == 0xFF)
+		{
+			abort = 1;
+			break;
+		}
+	}
+
+	if (abort)
+	{
+		return -1;
+	}
+
+	//dev->brightness = 3;	// 降低亮度，默认白色数显
+	switch (dev->brightness)
+	{
+		case 1:
+			value = FD650_SYSON_1;
+			break;
+		case 2:
+			value = FD650_SYSON_2;
+			break;
+		case 3:
+			value = FD650_SYSON_3;
+			break;
+		case 4:
+			value = FD650_SYSON_4;
+			break;
+		case 5:
+			value = FD650_SYSON_5;
+			break;
+		case 6:
+			value = FD650_SYSON_6;
+			break;
+		case 7:
+			value = FD650_SYSON_7;
+			break;
+		case 8:
+			value = FD650_SYSON_8;
+			break;
+		default:
+			value = FD650_SYSON_8;
+			break;
+	}
+
+	// 开启显示和键盘，8段显示方式
+	FD650_Mcu_Write(value, dev);
+#ifndef CONFIG_FD650_REVERT
+	//点亮第一个数码管
+	value = FD650_DIG0;
+	value |= (uint8)data[0];
+	FD650_Mcu_Write(value, dev);
+
+	//点亮第二个数码管，带冒号
+	value = FD650_DIG1;
+	value |= (uint8)data[1];
+	if(dev->dot_fg == 0x00)
+	{
+		value &= ~SEG_H;
+	}
+	else
+	{
+		value |= SEG_H;
+	}
+	FD650_Mcu_Write(value, dev);
+
+	// 点亮第三个数码管
+	value = FD650_DIG2;
+	value |= (uint8)data[2];
+	FD650_Mcu_Write(value, dev);
+
+	//点亮第四个数码管
+	value = FD650_DIG3;
+	value |= (uint8)data[3];
+	FD650_Mcu_Write(value, dev);
+#else
+	//点亮第一个数码管
+	value = FD650_DIG0;
+	value |= (uint8)data[3];
+	FD650_Mcu_Write(value, dev);
+
+	//点亮第二个数码管，带冒号
+	value = FD650_DIG1;
+	value |= (uint8)data[2];
+	if(dev->dot_fg == 0x00)
+	{
+		value &= ~SEG_H;
+	}
+	else
+	{
+		value |= SEG_H;
+	}
+	FD650_Mcu_Write(value, dev);
+
+	// 点亮第三个数码管
+	value = FD650_DIG2;
+	value |= (uint8)data[1];
+	FD650_Mcu_Write(value, dev);
+
+	//点亮第四个数码管
+	value = FD650_DIG3;
+	value |= (uint8)data[0];
+	FD650_Mcu_Write(value, dev);
+#endif
+
+	return 0;
+}
