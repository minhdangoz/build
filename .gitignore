### Specific to building Armbian ###
/.vagrant/
ubuntu-*-cloudimg-console.log

### to ignore changes in a working copy
.ignore_changes

### compile configurations added by users
/config-*.conf
### but not default (supplied) files
!/config-docker.conf
!/config-vagrant.conf

### output directories
/.tmp/
/output/
/cache/
/*userpatches*/
/userpatches

### General annoyances ###
.DS_Store
*~
*.swp
**/__pycache__/

# Mainly generated by merge tools like 'meld'
*.orig

# Dockerfile and .dockerignore is generated by docker.sh
Dockerfile
.dockerignore

### TX68: never commit the Android BSP's secure-boot signing keys or other
### derived/binary artifacts. android-pack/ is a local copy of vendor
### material (private m1k_go TOC1 signing keys, pack_out binaries) copied
### from the Android checkout -- leaking the keys would let anyone forge a
### valid secure boot chain for this device. uboot-debs/ are build outputs,
### reproducible from source, not something to track. Both are reproduced
### by re-copying/rebuilding, see tx68/scripts/tx68-build-phoenix-image.sh.
/tx68/android-pack/
/tx68/uboot-debs/
